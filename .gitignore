# ============================================
# PharmaFlow PRO ERP
# Git Ignore Rules
# ============================================

# --------------------------------------------
# Dependencies
# --------------------------------------------
node_modules/

# --------------------------------------------
# Environment files / Secrets
# --------------------------------------------
.env
.env.*
!.env.example
!.env.template

# --------------------------------------------
# Logs
# --------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# --------------------------------------------
# Build output
# --------------------------------------------
dist/
build/
out/
.next/

# --------------------------------------------
# Test coverage
# --------------------------------------------
coverage/
.nyc_output/

# --------------------------------------------
# Tool caches
# IMPORTANT:
# Only ignore generated root-level caches.
# Do NOT use a generic "cache" rule because
# source folders may legitimately be named cache.
# --------------------------------------------
/cache/
.vite/
.turbo/
.parcel-cache/
.eslintcache
.tsbuildinfo

# --------------------------------------------
# Cloudflare / Wrangler generated files
# --------------------------------------------
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# --------------------------------------------
# Local databases / generated runtime data
# --------------------------------------------
*.sqlite
*.sqlite-shm
*.sqlite-wal

# --------------------------------------------
# OS files
# --------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------
# IDE / Editor files
# --------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml
*.suo
*.user
*.userossc
*.sln.docstates

# --------------------------------------------
# Temporary files
# --------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# --------------------------------------------
# Package manager / runtime generated files
# --------------------------------------------
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# --------------------------------------------
# Local application runtime directories only
# --------------------------------------------
/tmp/
/temp/
/uploads/

# ============================================
# IMPORTANT: NEVER ignore source directories
# ============================================
# Do NOT add:
# cache
# config
# src
# server
# apps
#
# This ensures source folders such as:
#
# src/features/purchases/services/smartImport/cache/
#
# are tracked by Git.
# ============================================

# ─── AI Studio build exclusion ───
# Vercel-only files: hidden from AI Studio's Share process.
# Already committed to git — this does NOT remove them from GitHub.
vercel.json
