{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/[...slug].ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/server.cjs"
    }
  }
}
