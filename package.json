{
  "name": "pharmaflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:vercel": "vite build && esbuild server/app.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src --ext ts,tsx --max-warnings 0",
    "test:sync": "tsx scripts/test-phase8.3-sync-security.ts",
    "test:inventory-engine": "tsx scripts/test-unified-inventory-engine-foundation.ts",
    "test:sales-migration": "tsx scripts/test-sales-inventory-migration.ts",
    "test:purchase-migration": "tsx scripts/test-purchase-inventory-migration.ts",
    "test:phase5": "tsx scripts/test-phase5-multi-device-conflict.ts",
    "test:phase6-part2": "tsx scripts/test-phase6-part2-ai-safe-advisory.ts",
    "test": "vitest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@prisma/adapter-pg": "^6.4.0",
    "@prisma/client": "^6.4.0",
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "chart.js": "4.4.1",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.2.1",
    "dexie": "3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.13.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "0.460.0",
    "motion": "^12.35.0",
    "multer": "^2.1.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prisma": "^6.4.0",
    "react": "18.3.1",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.14.0",
    "react-window": "1.8.10",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vercel/node": "^3.2.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fake-indexeddb": "^6.2.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.1"
  }
}
