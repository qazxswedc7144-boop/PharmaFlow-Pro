// prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  POST_JOURNAL
  USER_REGISTER
  USER_LOGIN
  LOCK_ACQUIRED
  LOCK_RELEASED
  LOCK_EXTENDED
  LOCK_RECOVERY
  REPLICATION_PUBLISHED
}

enum Role {
  PLATFORM_OWNER
  TENANT_ADMIN
  ADMIN
  ACCOUNTANT
  PHARMACIST
  CASHIER
  AUDITOR
  INVENTORY_MANAGER
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InvoiceType {
  SALE
  PURCHASE
  RETURN_SALE
  RETURN_PURCHASE
}

enum SalesTaxMode {
  NONE
  EXCLUSIVE
  INCLUSIVE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIALLY_PAID
}

enum DocumentStatus {
  ACTIVE
  POSTED
  ARCHIVED
  LOCKED
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER
  RETURN
}

enum SalesReturnStatus {
  DRAFT
  VALIDATED
  POSTED
  CANCELLED
}

enum ReturnItemCondition {
  SELLABLE
  DAMAGED
  QUARANTINED
}

enum SalesReturnRefundMethod {
  CASH
  CUSTOMER_CREDIT
  WALLET
  BANK_TRANSFER
  MIXED
}

model User {
  id                  String                   @id @default(uuid())
  username            String                   @unique
  passwordHash        String
  role                Role                     @default(CASHIER)
  isActive            Boolean                  @default(true)
  version             Int                      @default(0)
  lastLoginAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  auditLogs           AuditLog[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  branchUsers         BranchUser[]
  tenantUsers         TenantUser[]
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model CustomRole {
  id           String           @id @default(uuid())
  tenantId     String?
  name         String
  description  String?
  isSystemRole Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id              String                   @id @default(uuid())
  key             String                   @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([module])
  @@index([key])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String     @id @default(uuid())
  userId    String
  tenantId  String
  roleId    String
  branchId  String?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CustomRole @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, roleId, tenantId, branchId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@index([branchId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String           @id @default(uuid())
  userId       String
  tenantId     String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, permissionId, tenantId])
  @@index([userId])
  @@index([permissionId])
  @@index([tenantId])
  @@map("user_permission_overrides")
}

model Account {
  id        String      @id @default(uuid())
  code      String
  name      String
  type      AccountType
  parentId  String?
  parent    Account?    @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Account[]   @relation("AccountHierarchy")
  isSystem  Boolean     @default(false)
  balance   Decimal     @default(0.00) @db.Decimal(18, 4)
  version   Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  journalLines JournalLine[] @relation("AccountJournalLines")

  @@unique([id, tenantId])
  @@unique([code, tenantId])
  @@index([parentId])
  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {
  id          String        @id @default(uuid())
  date        DateTime      @default(now())
  sourceId    String? // e.g. Link to Invoice ID
  sourceType  String? // "INVOICE", "VOUCHER", "MANUAL"
  referenceId String? // Invoice/receipt reference number
  status      String        @default("DRAFT") // DRAFT, POSTED, REVERSED
  description String?
  debitTotal  Decimal       @default(0.00) @db.Decimal(18, 4)
  creditTotal Decimal       @default(0.00) @db.Decimal(18, 4)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lines       JournalLine[]
  branchId    String?
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([sourceId, sourceType])
  @@index([date])
  @@index([branchId])
  @@index([tenantId])
  @@map("journal_entries")
}

model JournalLine {
  id          String       @id @default(uuid())
  tenantId    String
  entryId     String
  entry       JournalEntry @relation(fields: [entryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  accountId   String
  account     Account      @relation("AccountJournalLines", fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  debit       Decimal      @default(0.00) @db.Decimal(18, 4)
  credit      Decimal      @default(0.00) @db.Decimal(18, 4)
  description String?
  createdAt   DateTime     @default(now())

  @@index([tenantId])
  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Product {
  id                  String               @id @default(uuid())
  name                String
  barcode             String?
  sku                 String?
  description         String?
  price               Decimal              @default(0.00) @db.Decimal(18, 4)
  cost                Decimal              @default(0.00) @db.Decimal(18, 4)
  stockQuantity       Int                  @default(0)
  version             Int                  @default(0)
  isSystem            Boolean              @default(false)
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  inventoryBatches    InventoryBatch[]
  inventoryMovements  InventoryMovement[]
  reservations        Reservation[]
  invoiceItems        InvoiceItem[]        @relation("ProductInvoiceItems")
  salesReturnItems    SalesReturnItem[]     @relation("SalesReturnItemProduct")
  fifoLayers          FifoLayer[]
  fifoConsumptionLogs FifoConsumptionLog[]
  salesReturnFifoAllocations SalesReturnFifoAllocation[]
  branchInventories   BranchInventory[]    @relation("ProductBranchInventories")
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchTransferItems BranchTransferItem[]

  @@unique([id, tenantId])
  @@unique([tenantId, barcode])
  @@unique([tenantId, sku])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([tenantId])
  @@map("products")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  balance   Decimal  @default(0.00) @db.Decimal(18, 4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesReturns SalesReturn[] @relation("CustomerSalesReturns")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("customers")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  balance   Decimal  @default(0.00) @db.Decimal(18, 4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("suppliers")
}

model Invoice {
  id              String         @id @default(uuid())
  invoiceNumber   String
  clientRefId     String?
  date            DateTime       @default(now())
  type            InvoiceType
  partnerId       String? // References Customer or Supplier uuid
  partnerType     String? // "CUSTOMER" or "SUPPLIER"
  subtotalAmount  Decimal        @default(0.00) @db.Decimal(18, 4)
  discountPercent Decimal        @default(0.00) @db.Decimal(5, 2)
  discountAmount  Decimal        @default(0.00) @db.Decimal(18, 4)
  taxRatePercent  Decimal        @default(0.00) @db.Decimal(5, 2)
  taxAmount       Decimal        @default(0.00) @db.Decimal(18, 4)
  taxMode         SalesTaxMode   @default(NONE)
  totalAmount     Decimal        @default(0.00) @db.Decimal(18, 4)
  status         InvoiceStatus  @default(DRAFT)
  paymentStatus  PaymentStatus  @default(UNPAID)
  documentStatus DocumentStatus @default(ACTIVE)
  isSynced       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          InvoiceItem[]
  branchId       String?
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?        @relation("InvoiceBranch", fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  salesReturns    SalesReturn[]  @relation("OriginalSaleReturns")
  fifoLayersCreated FifoLayer[]  @relation("FifoLayerSourceInvoice")
  fifoConsumptionLogs FifoConsumptionLog[] @relation("FifoConsumptionInvoice")
  invoicePaymentAllocations InvoicePaymentAllocation[]

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, clientRefId])
  @@index([date])
  @@index([partnerId])
  @@index([createdAt])
  @@index([branchId])
  @@index([tenantId])
  @@map("invoices")
}

model InvoiceItem {
  id         String    @id @default(uuid())
  tenantId   String
  invoiceId  String
  invoice    Invoice   @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  productId  String
  product    Product   @relation("ProductInvoiceItems", fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  qty        Int
  price      Decimal   @db.Decimal(18, 4)
  cost       Decimal   @db.Decimal(18, 4)
  total      Decimal   @db.Decimal(18, 4)
  expiryDate DateTime?
  note       String?
  category   String?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  salesReturnItems SalesReturnItem[] @relation("OriginalInvoiceItemReturns")

  @@unique([id, tenantId, invoiceId])
  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model InventoryBatch {
  id                 String              @id @default(uuid())
  productId          String
  product            Product             @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  batchNumber        String
  initialQty         Int
  stockQuantity      Int
  cost               Decimal             @db.Decimal(18, 4)
  expiryDate         DateTime?
  version            Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  reservations       Reservation[]
  fifoLayers         FifoLayer[] @relation("FifoLayerBatch")
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([productId, batchNumber, tenantId])
  @@index([expiryDate])
  @@index([batchNumber])
  @@index([createdAt])
  @@index([tenantId])
  @@index([productId])
  @@map("inventory_batches")
}

model InventoryMovement {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  batchId       String?
  batch         InventoryBatch? @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: SetNull)
  qty           Int // Positive for additions, negative for reductions
  type          MovementType
  referenceId   String? // Document ID triggering this
  referenceType String? // "INVOICE", "ADJUSTMENT", "TRANSFER"
  reason        String?
  previousStock Int
  currentStock  Int
  createdAt     DateTime        @default(now())
  branchId      String?
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([batchId])
  @@index([createdAt])
  @@index([branchId])
  @@index([tenantId])
  @@map("inventory_movements")
}

model AuditLog {
  id        String          @id @default(uuid())
  timestamp DateTime        @default(now())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditActionType
  entity    String // "Account", "Invoice", "Product", "Role", "Permission", "UserRole"
  entityId  String
  before    String?         @db.Text // JSON string state
  after     String?         @db.Text // JSON string state
  ipAddress String?
  requestId String?
  createdAt DateTime        @default(now())
  branchId  String?
  tenantId  String?

  @@index([timestamp])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([branchId])
  @@index([tenantId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key            String
  requestHash    String
  endpoint       String
  requestMethod  String
  userId         String?
  responseBody   Json?
  responseStatus Int?
  processing     Boolean   @default(false)
  lockedAt       DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@unique([tenantId, key])
  @@index([key])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([tenantId])
  @@map("idempotency_keys")
}

model SyncQueue {
  id         String     @id @default(uuid())
  syncStatus SyncStatus @default(PENDING)
  payload    Json
  entityType String
  entityId   String
  action     String
  attempts   Int        @default(0)
  lastError  String?    @db.Text
  version    Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([syncStatus])
  @@index([createdAt])
  @@index([tenantId])
  @@map("sync_queue")
}

model SyncEvent {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId     String   @unique @default(uuid())
  sequence    BigInt   @unique @default(autoincrement())
  clientTime  DateTime
  serverTime  DateTime @default(now())
  userId      String?
  deviceId    String?
  eventType   String
  entityType  String
  entityId    String
  payload     Json
  vectorClock Json? // for vector-ready event ordering
  checksum    String? // for data integrity check
  createdAt   DateTime @default(now())
  branchId    String?

  @@index([eventId])
  @@index([sequence])
  @@index([createdAt])
  @@index([branchId])
  @@index([tenantId])
  @@map("sync_events")
}

model Reservation {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservationId String            @unique @default(uuid())
  productId     String
  product       Product           @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  batchId       String?
  batch         InventoryBatch?   @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: SetNull)
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  userId        String?
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  branchId      String?

  @@index([reservationId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([branchId])
  @@index([tenantId])
  @@map("reservations")
}

model Branch {
  id                  String               @id @default(uuid())
  code                String
  name                String
  location            String?
  phone               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  settings            BranchSettings?
  branchInventory     BranchInventory[]
  branchUsers         BranchUser[]
  userRoles           UserRole[]
  transfersSource     BranchTransfer[]     @relation("SourceBranch")
  transfersTarget     BranchTransfer[]     @relation("TargetBranch")
  invoices            Invoice[]             @relation("InvoiceBranch")
  salesReturns        SalesReturn[]          @relation("SalesReturnBranch")
  fifoLayers          FifoLayer[]            @relation("FifoLayerBranch")
  fifoConsumptionLogs FifoConsumptionLog[]   @relation("FifoConsumptionBranch")
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceRegistrations DeviceRegistration[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model BranchSettings {
  id                    String   @id @default(uuid())
  branchId              String   @unique
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  minStockLevelAlert    Boolean  @default(true)
  autoReorderTargetDays Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("branch_settings")
}

model BranchInventory {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch   @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  productId       String
  product         Product  @relation("ProductBranchInventories", fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stockQuantity   Int      @default(0)
  reorderPoint    Int      @default(10)
  reorderQuantity Int      @default(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_inventory")
}

model BranchTransfer {
  id             String               @id @default(uuid())
  transferNumber String
  sourceBranchId String
  sourceBranch   Branch               @relation("SourceBranch", fields: [sourceBranchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  targetBranchId String
  targetBranch   Branch               @relation("TargetBranch", fields: [targetBranchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  status         String               @default("DRAFT") // DRAFT, APPROVED, IN_TRANSIT, RECEIVED, CANCELLED
  reason         String?
  createdBy      String?
  approvedBy     String?
  shippedBy      String?
  receivedBy     String?
  shippedAt      DateTime?
  receivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          BranchTransferItem[]
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, transferNumber])
  @@index([sourceBranchId])
  @@index([targetBranchId])
  @@index([status])
  @@index([tenantId])
  @@map("branch_transfers")
}

model BranchTransferItem {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transferId  String
  transfer    BranchTransfer @relation(fields: [transferId, tenantId], references: [id, tenantId], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  qty         Int
  receivedQty Int?           @default(0)
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime       @default(now())

  @@index([transferId])
  @@index([productId])
  @@index([tenantId])
  @@map("branch_transfer_items")
}

model BranchUser {
  id         String     @id @default(uuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch     @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantUser TenantUser @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  isDefault  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([branchId, userId])
  @@index([branchId])
  @@index([userId])
  @@index([tenantId])
  @@map("branch_users")
}

model Payment {
  id            String   @id @default(uuid())
  paymentNumber String?
  date          DateTime @default(now())
  amount        Decimal  @default(0.00) @db.Decimal(18, 4)
  partnerId     String?
  partnerType   String? // "CUSTOMER" or "SUPPLIER"
  paymentMethod String   @default("CASH")
  referenceId   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  invoicePaymentAllocations InvoicePaymentAllocation[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([branchId])
  @@index([date])
  @@map("payments")
}

model Expense {
  id            String   @id @default(uuid())
  expenseNumber String?
  date          DateTime @default(now())
  amount        Decimal  @default(0.00) @db.Decimal(18, 4)
  category      String?
  accountId     String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?

  @@index([tenantId])
  @@index([branchId])
  @@index([date])
  @@map("expenses")
}

model Tenant {
  id                  String                   @id @default(uuid())
  name                String
  domain              String?                  @unique
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  users               TenantUser[]
  subscriptions       TenantSubscription[]
  licenses            License[]
  usageCounters       UsageCounter[]
  branches            Branch[]
  products            Product[]
  customers           Customer[]
  suppliers           Supplier[]
  invoices            Invoice[]
  accounts            Account[]
  journalEntries      JournalEntry[]
  branchTransfers     BranchTransfer[]
  inventoryMovements  InventoryMovement[]
  inventoryBatches    InventoryBatch[]
  payments            Payment[]
  expenses            Expense[]
  roles               CustomRole[]
  userRoles           UserRole[]
  idempotencyKeys     IdempotencyKey[]
  syncQueues          SyncQueue[]
  syncEvents          SyncEvent[]
  reservations        Reservation[]
  branchInventories   BranchInventory[]
  deviceRegistrations DeviceRegistration[]     @relation("TenantDeviceRegistrations")
  userOverrides       UserPermissionOverride[]
  branchTransferItems BranchTransferItem[]
  branchUsers         BranchUser[]
  salesPolicy         TenantSalesPolicy?
  salesReturns        SalesReturn[]
  salesReturnItems    SalesReturnItem[]
  salesReturnRefunds  SalesReturnRefund[]
  salesReturnFifoAllocations SalesReturnFifoAllocation[]
  invoicePaymentAllocations InvoicePaymentAllocation[]
  fifoLayers          FifoLayer[]
  fifoConsumptionLogs FifoConsumptionLog[]

  @@map("tenants")
}


model SalesReturn {
  id              String                  @id @default(uuid())
  tenantId        String
  branchId        String
  returnNumber    String
  originalSaleId  String
  customerId      String?
  status          SalesReturnStatus       @default(DRAFT)
  refundMethod    SalesReturnRefundMethod
  refundReference String?
  currencyCode    String
  subtotalAmount  Decimal                 @default(0.00) @db.Decimal(18, 4)
  discountAmount  Decimal                 @default(0.00) @db.Decimal(18, 4)
  taxAmount       Decimal                 @default(0.00) @db.Decimal(18, 4)
  totalAmount     Decimal                 @default(0.00) @db.Decimal(18, 4)
  idempotencyKey  String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  postedAt        DateTime?
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch                  @relation("SalesReturnBranch", fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  originalSale    Invoice                 @relation("OriginalSaleReturns", fields: [originalSaleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer        Customer?               @relation("CustomerSalesReturns", fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  items           SalesReturnItem[]
  refunds         SalesReturnRefund[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, originalSaleId])
  @@unique([tenantId, returnNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, originalSaleId, status])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id                    String                    @id @default(uuid())
  tenantId              String
  returnId              String
  originalSaleId        String
  originalInvoiceItemId String
  productId             String
  quantity              Int
  condition             ReturnItemCondition
  unitPrice             Decimal                   @db.Decimal(18, 4)
  subtotalAmount        Decimal                   @default(0.00) @db.Decimal(18, 4)
  discountAmount        Decimal                   @default(0.00) @db.Decimal(18, 4)
  taxRatePercent        Decimal                   @default(0.00) @db.Decimal(5, 2)
  taxAmount             Decimal                   @default(0.00) @db.Decimal(18, 4)
  totalAmount           Decimal                   @default(0.00) @db.Decimal(18, 4)
  createdAt             DateTime                  @default(now())
  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesReturn           SalesReturn               @relation(fields: [returnId, tenantId, originalSaleId], references: [id, tenantId, originalSaleId], onDelete: Cascade)
  originalInvoiceItem   InvoiceItem               @relation("OriginalInvoiceItemReturns", fields: [originalInvoiceItemId, tenantId, originalSaleId], references: [id, tenantId, invoiceId], onDelete: Restrict)
  product               Product                   @relation("SalesReturnItemProduct", fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  fifoAllocations       SalesReturnFifoAllocation[]

  @@unique([id, tenantId])
  @@index([tenantId, returnId])
  @@index([tenantId, originalInvoiceItemId])
  @@index([tenantId, productId])
  @@index([tenantId, condition])
  @@map("sales_return_items")
}

model FifoLayer {
  id                String                 @id @default(uuid())
  tenantId          String
  branchId          String?
  productId         String
  inventoryBatchId  String?
  sourceInvoiceId   String?
  quantityInitial   Int
  quantityRemaining Int
  unitCost          Decimal                @db.Decimal(18, 4)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                @relation("FifoLayerBranch", fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  product           Product                @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  inventoryBatch    InventoryBatch?        @relation("FifoLayerBatch", fields: [inventoryBatchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sourceInvoice     Invoice?               @relation("FifoLayerSourceInvoice", fields: [sourceInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  consumptionLogs   FifoConsumptionLog[]
  returnAllocations SalesReturnFifoAllocation[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, productId])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, branchId, productId])
  @@index([tenantId, inventoryBatchId])
  @@map("fifo_layers")
}

model FifoConsumptionLog {
  id                String                    @id @default(uuid())
  tenantId          String
  branchId          String?
  invoiceId         String
  productId         String
  layerId           String
  quantityConsumed  Int
  unitCost          Decimal                   @db.Decimal(18, 4)
  createdAt         DateTime                  @default(now())
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                   @relation("FifoConsumptionBranch", fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  invoice           Invoice                   @relation("FifoConsumptionInvoice", fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  product           Product                   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  layer             FifoLayer                 @relation(fields: [layerId, tenantId, productId], references: [id, tenantId, productId], onDelete: Restrict)
  returnAllocations SalesReturnFifoAllocation[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, layerId, productId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, layerId])
  @@index([tenantId, branchId, productId])
  @@map("fifo_consumption_logs")
}

model SalesReturnFifoAllocation {
  id                    String             @id @default(uuid())
  tenantId              String
  returnItemId          String
  originalConsumptionId String
  layerId               String
  productId             String
  quantity              Int
  unitCost              Decimal            @db.Decimal(18, 4)
  totalCost             Decimal            @db.Decimal(18, 4)
  createdAt             DateTime           @default(now())
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returnItem            SalesReturnItem    @relation(fields: [returnItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  originalConsumption   FifoConsumptionLog @relation(fields: [originalConsumptionId, tenantId, layerId, productId], references: [id, tenantId, layerId, productId], onDelete: Restrict)
  layer                 FifoLayer          @relation(fields: [layerId, tenantId, productId], references: [id, tenantId, productId], onDelete: Restrict)
  product               Product            @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, returnItemId, originalConsumptionId])
  @@index([tenantId, originalConsumptionId])
  @@index([tenantId, layerId])
  @@index([tenantId, returnItemId])
  @@map("sales_return_fifo_allocations")
}

model InvoicePaymentAllocation {
  id            String                @id @default(uuid())
  tenantId      String
  invoiceId     String
  paymentId     String
  amount        Decimal               @db.Decimal(18, 4)
  createdAt     DateTime              @default(now())
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice               @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payment       Payment               @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  returnRefunds SalesReturnRefund[]

  @@unique([id, tenantId, invoiceId])
  @@unique([tenantId, invoiceId, paymentId])
  @@index([tenantId, paymentId])
  @@index([tenantId, invoiceId])
  @@map("invoice_payment_allocations")
}

model SalesReturnRefund {
  id                        String                    @id @default(uuid())
  tenantId                  String
  returnId                  String
  originalSaleId            String
  sourcePaymentAllocationId String?
  method                    SalesReturnRefundMethod
  amount                    Decimal                   @db.Decimal(18, 4)
  reference                 String?
  createdAt                 DateTime                  @default(now())
  tenant                    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesReturn               SalesReturn               @relation(fields: [returnId, tenantId, originalSaleId], references: [id, tenantId, originalSaleId], onDelete: Cascade)
  sourcePaymentAllocation   InvoicePaymentAllocation? @relation(fields: [sourcePaymentAllocationId, tenantId, originalSaleId], references: [id, tenantId, invoiceId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, returnId])
  @@index([tenantId, sourcePaymentAllocationId])
  @@map("sales_return_refunds")
}

model TenantSalesPolicy {
  id                 String       @id @default(uuid())
  tenantId           String       @unique
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maxDiscountPercent Decimal      @default(0.00) @db.Decimal(5, 2)
  taxRatePercent     Decimal      @default(0.00) @db.Decimal(5, 2)
  taxMode            SalesTaxMode @default(NONE)
  updatedBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("tenant_sales_policies")
}

model TenantUser {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String       @default("TENANT_ADMIN")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  branchUsers BranchUser[]

  @@unique([tenantId, userId])
  @@unique([userId, tenantId])
  @@map("tenant_users")
}

model SubscriptionPlan {
  id               String               @id @default(uuid())
  code             String               @unique // TRIAL, BASIC, BUSINESS, ENTERPRISE
  name             String
  price            Decimal              @db.Decimal(18, 4)
  durationDays     Int
  transactionLimit Int                  @default(-1) // -1 means unlimited, TRIAL has 200
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  subscriptions    TenantSubscription[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate DateTime         @default(now())
  endDate   DateTime
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("tenant_subscriptions")
}

model License {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  licenseKey String   @unique
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("licenses")
}

model UsageCounter {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionCount Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([tenantId])
  @@map("usage_counters")
}

model CrashLog {
  id                String   @id @default(uuid())
  tenantId          String?
  branchId          String?
  userId            String?
  route             String
  deviceFingerprint String?
  appVersion        String?
  stackTrace        String?  @db.Text
  errorMessage      String   @db.Text
  timestamp         DateTime @default(now())

  @@index([timestamp])
  @@index([tenantId])
  @@index([branchId])
  @@map("crash_logs")
}

model DeviceRegistration {
  deviceId       String   @id
  tenantId       String
  tenant         Tenant   @relation("TenantDeviceRegistrations", fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch   @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deviceName     String
  androidVersion String?
  appVersion     String?
  lastSync       DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([branchId])
  @@map("device_registrations")
}

model AiUsageLog {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  model         String
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  estimatedCost Float    @default(0.0)
  timestamp     DateTime @default(now())

  @@index([timestamp])
  @@index([tenantId])
  @@index([userId])
  @@map("ai_usage_logs")
}
